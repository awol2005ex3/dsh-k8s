{
  "name": "dsh-k8s",
  "version": "0.1.0",
  "description": "DeepSeek Harness (dsh) plugin: 多个 Kubernetes 集群运维（兼容不同 k8s 版本）。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/wrap-client.mjs",
    "typecheck": "tsc --noEmit",
    "check:client": "npm run build && node scripts/check-client.mjs",
    "test": "npm run check:client"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "kubernetes",
    "k8s",
    "ops"
  ],
  "dependencies": {
    "@kubernetes/client-node": "^1.1.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  }
}
